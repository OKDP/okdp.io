---
import type { HomeTranslations } from "@/i18n/translations";

interface Props {
  content: HomeTranslations;
}

const { content } = Astro.props;
---

<section id="tosit" class="section bg-background-alt">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4">{content.tosit.title}</h2>
      <p class="text-text-light mb-6" set:html={content.tosit.desc1} />
      <p class="text-text-light mb-6" set:html={content.tosit.desc2} />
      <p class="text-text-light">{content.tosit.desc3}</p>
    </div>
  </div>
</section>
