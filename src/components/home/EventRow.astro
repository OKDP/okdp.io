---
import type { LocalizedEvent } from "@/types/events";

interface Props {
  event: LocalizedEvent;
  past?: boolean;
}

const { event, past = false } = Astro.props;
---

<div
  class:list={[
    "border-accent/80 flex flex-col gap-1 border-b px-4 py-3 last:border-b-0 sm:grid sm:grid-cols-[10rem_1fr_auto] sm:items-baseline sm:gap-x-6 sm:gap-y-0",
    past && "opacity-60",
  ]}
>
  <span
    class="text-text-light font-mono text-xs tracking-tight whitespace-nowrap tabular-nums"
    >{event.dateISO}</span
  >
  <div class="min-w-0">
    <div class="text-text text-sm leading-snug font-medium">{event.title}</div>
    {
      event.description && (
        <div class="text-text-light mt-1 text-xs leading-snug">
          {event.description}
        </div>
      )
    }
    {
      event.source && (
        <a
          href={event.source}
          download
          target="_blank"
          rel="noopener"
          class="text-primary mt-1 block font-mono text-xs break-all hover:underline"
        >
          <svg
            class="mr-1 inline-block h-3 w-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          {event.source}
        </a>
      )
    }
  </div>
  {
    event.location && (
      <span class="text-text-light text-xs">{event.location}</span>
    )
  }
</div>
