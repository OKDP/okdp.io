---
import type { HomeTranslations } from "@/i18n/translations";

interface Props {
  content: HomeTranslations;
}

const { content } = Astro.props;
---

<section id="community" class="section bg-background">
  <div class="container">
    <div class="mb-16 text-center">
      <h2 class="mb-4">{content.community.title}</h2>
      <p class="text-text-light mx-auto max-w-2xl">
        {content.community.subtitle}
      </p>
    </div>

    <div
      class="from-primary/10 to-primary/5 border-primary/20 mx-auto mb-12 max-w-2xl rounded-lg border-2 bg-linear-to-r p-8"
    >
      <div class="flex items-start gap-4">
        <div class="shrink-0">
          <div
            class="bg-primary flex h-12 w-12 items-center justify-center rounded-full"
          >
            <svg
              class="h-6 w-6 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
        </div>
        <div class="flex-1">
          <h3 class="mb-2 text-xl font-semibold">
            {content.community.meeting.title}
          </h3>
          <p class="text-text-light mb-4">{content.community.meeting.desc}</p>
          <a
            href="https://github.com/orgs/OKDP/discussions"
            class="text-primary hover:text-primary-dark inline-flex items-center gap-2 font-medium"
          >
            {content.community.meeting.cta}
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div
      class="mx-auto mb-12 flex max-w-5xl flex-wrap justify-center gap-3 text-sm md:flex-nowrap"
    >
      <a
        href="https://github.com/okdp"
        target="_blank"
        rel="noopener noreferrer"
        class="card flex min-w-45 flex-1 items-center gap-2 px-3 py-3 transition-shadow hover:shadow-md"
      >
        <div
          class="bg-primary/10 flex h-10 w-10 items-center justify-center rounded-full"
        >
          <svg
            class="text-primary h-5 w-5"
            viewBox="0 0 98 96"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill="currentColor"
              d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"
            ></path>
          </svg>
        </div>
        <h3 class="text-sm font-semibold">GitHub</h3>
      </a>

      <a
        href="https://central.sonatype.com/namespace/io.okdp"
        target="_blank"
        rel="noopener noreferrer"
        class="card flex min-w-45 flex-1 items-center gap-2 px-3 py-3 transition-shadow hover:shadow-md"
      >
        <div
          class="bg-primary/10 flex h-10 w-10 items-center justify-center rounded-full"
        >
          <svg
            class="text-primary h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
            ></path>
          </svg>
        </div>
        <h3 class="text-sm font-semibold">Maven Central</h3>
      </a>

      <a
        href="https://quay.io/organization/okdp"
        target="_blank"
        rel="noopener noreferrer"
        class="card flex min-w-45 flex-1 items-center gap-2 px-3 py-3 transition-shadow hover:shadow-md"
      >
        <div
          class="bg-primary/10 flex h-10 w-10 items-center justify-center rounded-full"
        >
          <svg
            class="text-primary h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2M7 7h10"
            ></path>
          </svg>
        </div>
        <h3 class="text-sm font-semibold">Container Registry</h3>
      </a>
    </div>

    <div class="bg-accent mx-auto max-w-4xl rounded-lg p-8 text-center">
      <h3 class="mb-4 text-xl font-semibold">
        {content.community.contribute.title}
      </h3>
      <p class="text-text-light mb-6">{content.community.contribute.desc}</p>
      <a
        href="https://github.com/orgs/okdp/people"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary px-4 py-2 text-sm"
        >{content.community.contribute.cta}</a
      >
    </div>
  </div>
</section>
