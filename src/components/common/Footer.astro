---
import { Image } from "astro:assets";
import OkdpInvertedLogo from "@/assets/logos/okdp-inverted.png";
import type { HomeTranslations } from "@/i18n/translations";

interface Props {
  content: HomeTranslations;
}

const { content } = Astro.props;
---

<footer class="bg-background-alt py-12">
  <div class="container">
    <div
      class="flex flex-col items-center justify-center gap-4 text-center md:flex-row md:text-left"
    >
      <Image src={OkdpInvertedLogo} alt="OKDP Logo" class="h-20 w-auto" />
      <div class="text-text-light space-y-1">
        <p class="text-sm">{content.footer.copyright}</p>
        <p class="text-xs">{content.footer.license}</p>
      </div>
    </div>
  </div>
</footer>
